# ---- Pulled automatically by `vercel link` / `vercel env pull` ----------------
# Short-lived OIDC token the @vercel/connect SDK and eve use to call Vercel
# Connect and AI Gateway locally. On Vercel this is injected automatically.
# Re-run `vercel env pull` if you see 401s locally.
VERCEL_OIDC_TOKEN=

# ---- Model credential for the eve agent -------------------------------------
# eve routes `openai/...` model ids through Vercel AI Gateway. On a live-billing
# team the OIDC token is enough; on a billing test-mode team (this demo's team)
# AI Gateway refuses OIDC, so an explicit key from a live-billing team is required.
# @ai-sdk/gateway prefers this over OIDC when set.
AI_GATEWAY_API_KEY=

# ---- Act 1: seeded MCP connectors (UIDs from `vercel connect create`) -------
# Defaults match the names used in SETUP.md; override if you named them differently.
CONNECT_NOTION_UID=notion/legato-notion
# Ledgerline mock (separate project ../ledgerline-mock). Defaults shown.
# (Ledgerline is a custom connector; the agent discovers it at runtime via the REST API)
LEDGERLINE_ORIGIN=https://ledgerline-mock.vercel.app
NEXT_PUBLIC_LEDGERLINE_ORIGIN=https://ledgerline-mock.vercel.app

# ---- Act 2: bring-your-own connectors via the Vercel REST API --------------
# Personal/team access token with permission to manage Connect on the team.
# Create one at https://vercel.com/account/tokens (scope it to the team).
VERCEL_TOKEN=
# Team that owns the connectors (`vercel teams ls` → id column is the slug;
# the team_… id is in .vercel/project.json as orgId).
VERCEL_TEAM_ID=
# Project the connectors get attached to (.vercel/project.json → projectId).
VERCEL_PROJECT_ID=
CONNECT_MASSIVE_UID=massive/legato-massive
